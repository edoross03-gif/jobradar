# --- Postgres (warehouse). Schema `jobradar` is created automatically. ---
DATABASE_URL=postgresql://jobradar:CHANGE_ME@warehouse-db:5432/warehouse
# Network of the warehouse compose project (used by docker-compose.override.yml):
WAREHOUSE_NETWORK=warehouse_default
# Standalone mode only (docker compose --profile standalone): DATABASE_URL=postgresql://jobradar:change-me@jobradar-db:5432/jobradar
JOBRADAR_DB_PASSWORD=change-me

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HC_PING_URL=https://hc-ping.com/<uuid>

# --- LLM scoring (stage 2). Empty key = rules filter only, nothing is scored. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Tuning ---
RUN_EVERY=2h
JOBRADAR_CONCURRENCY=8
NOTIFY_MAX=30
# Tiers alerted on every run; other tiers go into one daily digest after DIGEST_HOUR (local, TZ). Empty DIGEST_HOUR = no digest.
INSTANT_TIERS=A
DIGEST_HOUR=9
# LLM score shown/used for alerts = raw Gemini score × tier weight (capped at 100). Instant alert at INSTANT_SCORE.
TIER_WEIGHTS=A:1.5,B:1,C:0.66
INSTANT_SCORE=75
